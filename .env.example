PORT=3001

# Clave maestra de cifrado AES-256 (32 caracteres / bytes)
# Si se deja vacía o no existe, se generará automáticamente en data/.encryption_key
APP_ENCRYPTION_KEY=clave_secreta_maestra_de_32_bytes_123

# Secreto para firma de tokens JWT de sesión
JWT_SECRET=super_secret_jwt_key_para_sesiones_ssh_term_2026

# Configuración del Directorio LDAP / Active Directory
LDAP_URL=ldap://127.0.0.1:389
LDAP_BIND_DN=cn=admin,dc=empresa,dc=local
LDAP_BIND_PASSWORD=admin_password
LDAP_SEARCH_BASE=dc=empresa,dc=local
LDAP_SEARCH_FILTER=(&(objectClass=person)(|(uid={{username}})(sAMAccountName={{username}})))

# Habilitar modo desarrollo / fallback local si el servidor LDAP no está disponible
# Permite autenticarse con usuario 'admin' y contraseña 'admin' para pruebas locales
LDAP_DEV_MODE=true

# Administrador Global del Sistema (username o CN de LDAP)
# Este usuario tiene acceso total y permanente para aprobar otros usuarios y gestionar el sistema
GLOBAL_ADMIN_USER=admin
GLOBAL_ADMIN_CN=cn=admin,dc=empresa,dc=local

# Configuración HTTPS / TLS Nativo (Opción 2)
# Para habilitar HTTPS directo en Node.js, cambia SSL_ENABLED a true
# Ejecuta 'npm run ssl:gen' para generar certificados de prueba
SSL_ENABLED=false
SSL_CERT_PATH=data/ssl/cert.pem
SSL_KEY_PATH=data/ssl/key.pem

